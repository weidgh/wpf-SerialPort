<Window x:Class="demo1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="串口调试助手 (MVVM)" Height="760" Width="1220"
        Background="#0F172A">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Background" Value="#1E293B"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CaretBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827" CornerRadius="10" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="串口控制面板" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>

                    <GroupBox Header="串口配置">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="串口" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox Width="170" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}"/>
                                <Button Content="刷新" Command="{Binding RefreshPortsCommand}" Background="#475569"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="波特率" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="170" ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="2" Text="校验位" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="170" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SelectedParity, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="3" Text="数据位" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Width="170" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding SelectedDataBits, Mode=TwoWay}"/>

                            <TextBlock Grid.Row="4" Text="停止位" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Width="170" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SelectedStopBits, Mode=TwoWay}"/>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Content="RTS" IsChecked="{Binding RtsEnabled, Mode=TwoWay}"/>
                                <CheckBox Content="DTR" IsChecked="{Binding DtrEnabled, Mode=TwoWay}"/>
                            </StackPanel>

                            <Button Grid.Row="6" Grid.ColumnSpan="2" Content="{Binding OpenButtonText}" Command="{Binding TogglePortCommand}" Height="36" Margin="0,14,0,0"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="接收配置">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="自动清空" IsChecked="{Binding AutoClear, Mode=TwoWay}"/>
                                <CheckBox Content="十六进制显示" IsChecked="{Binding ReceiveHex, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="清空窗口" Command="{Binding ClearReceiveCommand}" Background="#DC2626"/>
                                <Button Content="{Binding PauseButtonText}" Command="{Binding ToggleReceivePauseCommand}" Background="#D97706"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="保存数据" Command="{Binding SaveDataCommand}" Background="#16A34A"/>
                                <Button Content="保存路径" Command="{Binding ChooseSavePathCommand}" Background="#475569"/>
                            </StackPanel>
                            <TextBox Margin="0,8,0,0" Text="{Binding SaveDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="发送配置">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="自动发送" IsChecked="{Binding AutoSendEnabled, Mode=TwoWay}"/>
                                <TextBox Width="66" Text="{Binding AutoSendInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="ms/次" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <CheckBox Content="十六进制发送" IsChecked="{Binding SendHex, Mode=TwoWay}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="手动发送" Command="{Binding SendCommand}"/>
                                <Button Content="清空发送" Command="{Binding ClearSendCommand}" Background="#475569"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="打开文件" Command="{Binding ChooseFileCommand}" Background="#475569"/>
                                <Button Content="发送文件" Command="{Binding SendFileCommand}" Background="#9333EA"/>
                            </StackPanel>
                            <TextBox Margin="0,8,0,0" Text="{Binding SendFilePath, Mode=TwoWay}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="#111827" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="数据显示" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                <TextBox Grid.Row="1"
                         Text="{Binding ReceiveLog, Mode=TwoWay}"
                         FontFamily="Consolas"
                         FontSize="13"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#020617"
                         BorderBrush="#1D4ED8"/>

                <TextBlock Grid.Row="2" Text="发送输入" Foreground="#CBD5E1" Margin="0,12,0,6"/>
                <TextBox Grid.Row="3"
                         Text="{Binding SendInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

                <StatusBar Grid.Row="4" Background="#0B1220" Foreground="#E2E8F0" Margin="0,12,0,0">
                    <StatusBarItem>
                        <TextBlock Text="状态:"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock Width="350" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                    </StatusBarItem>
                    <Separator/>
                    <StatusBarItem>
                        <TextBlock Text="发送计数:"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock Text="{Binding SendCount}"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock Text="接收计数:"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock Text="{Binding ReceiveCount}"/>
                    </StatusBarItem>
                    <StatusBarItem>
                        <Button Content="清空计数" Command="{Binding ClearCountCommand}" Background="#475569" Margin="6,0,0,0"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Border>
    </Grid>
</Window>
